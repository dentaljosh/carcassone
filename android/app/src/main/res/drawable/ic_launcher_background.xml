<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background layer.

  Flat field plus one oversized off-centre circle: the circle is bigger than the
  108dp canvas and anchored past the top-left corner, so whatever mask the
  launcher applies (circle, squircle, rounded square) it crops to a soft diagonal
  two-tone rather than to a visible ring.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#2E5D4B"
        android:pathData="M0,0h108v108h-108z" />

    <path
        android:fillColor="#37705C"
        android:pathData="M26,26 m-62,0 a62,62 0 1,0 124,0 a62,62 0 1,0 -124,0" />

</vector>
