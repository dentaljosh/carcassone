<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      REMOTE OPPONENT (2026-08-30). The app is otherwise fully offline and makes
      no network call of any kind; this permission exists solely so the optional
      "Remote Carcasum" opponent can reach
      scripts/carcasum_remote/server.py on the laptop, over the tailnet.

      usesCleartextTraffic: the server speaks plain HTTP on a private tailnet
      between two of the owner's own devices, and its address is a user-editable
      setting — so a network-security-config pinned to one IP would break the
      moment the address changed. The app sends nothing but (deck_seed, actions)
      and receives an integer. Documented rather than silently switched on:
      scripts/carcasum_remote/README.md carries the same note.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      BACKGROUND THINKING (2026-09-02). ThinkingService is a foreground service
      held for the duration of the opponent's turn so the process keeps its
      top-app cpuset (and stops being a memory-pressure candidate) when the app
      is backgrounded mid-search. See ThinkingService's kdoc for why the type is
      `dataSync` rather than `shortService`, and for why none of this is the
      correctness story — a killed process still resumes from the autosave.

      POST_NOTIFICATIONS is a runtime permission on API 33+. A DENIED grant hides
      the notification but does NOT stop the service, so nothing is gated on it.
      WAKE_LOCK keeps the CPU up with the screen off; the debug-sourceset
      BenchService already declares the same three for the battery bench.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CarcApplication"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarcassonneAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection"
            android:theme="@style/Theme.CarcassonneAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: started only by this app's own ViewModel, never by adb
             or another app (unlike the debug BenchService, which the host bench
             driver has to reach). -->
        <service
            android:name=".ThinkingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
