# written by denial_simsplit_chain.sh at 2026-08-12_01:53:47 - assign-if-unset, so a live env WINS.
# The watchdog sources this on restart; without it a restart has no knob values.
: "${DENIAL_DOSES:=1.0,4.0}"
: "${DENIAL_SIZE_MIN:=5}"
: "${DENIAL_OPEN_MAX:=3}"
: "${W_LOCAL:=30}"
: "${W_LAPTOP:=22}"
: "${D1_N:=200}"
: "${S1_N:=200}"
: "${SIMS_TILE:=2408}"
: "${SIMS_MEEPLE:=344}"
export DENIAL_DOSES DENIAL_SIZE_MIN DENIAL_OPEN_MAX W_LOCAL W_LAPTOP D1_N S1_N SIMS_TILE SIMS_MEEPLE
