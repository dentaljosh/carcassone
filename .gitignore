# Python
.venv/
.venv-cy/
# Cython build artifacts (flat_leaf_cy / flat_repr_cy: rebuild per box via the setup_*.py)
src/carcassonne_ai/flat_leaf_cy.c
src/carcassonne_ai/flat_repr_cy.c
src/carcassonne_ai/*.so
# carc-orch TorchScript exports (per-box, parity-gated rebuild via export_torchscript.py)
rust/carc-orch/*.ts.pt
*.ts.pt
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Project artifacts (large / regenerable)
data/
checkpoints/
runs/
# ...but tests/data/ is small, checked-in test FIXTURE data (vendored reference
# decks for the differential oracles), not a regenerable artifact.
!tests/data/
!tests/data/**

# Vendored reference (alpha-zero-general) — kept locally for reference but
# not tracked. Recover via `git clone https://github.com/suragnair/alpha-zero-general az/`
az/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Claude Code session metadata
.claude/

# Codex scratch state (review agent uses this)
.codex

# Hard-policy-repair: logs ephemeral; npz already covered by `data/` above
# (regenerable from mine_label.py + the committed multiphase pool). Manifests
# (jsonl) stay TRACKED for provenance.
measurement/hard_policy_repair/*.log

# High-gap distillation: logs ephemeral; npz (qprobe/data) already covered by
# `data/` above. The pilot qprobe/probe.jsonl (1.6M) stays TRACKED as provenance.
# The SCALED artifacts are LARGE + fully regenerable (gen seed band 1.94e9 +
# probe_signal_density.py + build_splits.py, all documented): pools (218M),
# per-leg probe.jsonl, and the 12.7M split manifests are ignored.
measurement/high_gap_distillation/**/*.log
measurement/high_gap_distillation/scaled/
measurement/high_gap_distillation/manifest_*.jsonl

# Value/search autopsy: logs ephemeral; the jsonl legs + miss-probe are LARGE and
# fully regenerable (miss_harness/classical_leg/forced_move on the committed Path-3
# qprobe + iter04). Full-pool controls live on the share. Docs (*.md) stay tracked.
measurement/value_search_autopsy/**/*.log
measurement/value_search_autopsy/data/

# Stray review artifacts (untracked zips + extractions) — not tracked, exclude from lint
clean_room_review_20260621/
clean_room_review_20260621.zip
outside_review.zip
measurement/post_search_residual/data/

# 5A arm-retrain weights (reproducible via scripts/probe_5a/run_arm_retrains.sh; evidence = summary/solver JSONs)
measurement/probe_5a/arms_retrain/**/ranknet_best.pt

# Leaf residual-mining (2026-07-21): the raw per-root labels are LARGE (16.7M + 2.6M).
# The .gz siblings ARE tracked as provenance; the uncompressed files are not.
measurement/leaf_residual_mining_20260721/records_primary.jsonl
measurement/leaf_residual_mining_20260721/records_replication.jsonl
measurement/leaf_residual_mining_20260721/freepass_k3champ.jsonl

# Android app (android/): machine-local SDK path + Gradle/AGP build output.
# The Gradle WRAPPER (gradlew, gradle/wrapper/**) stays tracked on purpose.
# app/build/python is the sync_python.py target — generated from src/, never edited.
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/tiles/
android/.idea/
android/*.iml

# M5 bench (scripts/m5_bench/): the assembled bundle + results are GENERATED by
# build_bundle.py (default target is the share, but it can be pointed in-tree).
# The scripts are tracked; nothing they produce is.
scripts/m5_bench/bundle/
scripts/m5_bench/results/
scripts/m5_bench/cython_build.log
scripts/m5_bench/MANIFEST.json

# F9/A3: worktree-local shadow of the carc_rs extension, so a build here can
# never reach the shared venv while a live eval farm is importing from it.
.rsshadow/
